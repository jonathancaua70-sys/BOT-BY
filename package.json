{
  "name": "discord-auth-bot",
  "version": "1.0.0",
  "description": "Bot de Discord + API de login integrada com MySQL (Aiven), pronta pro Render",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "deploy-commands": "node src/deployCommands.js",
    "backup": "node scripts/backupDatabase.js",
    "security-test": "node scripts/securityTest.js",
    "restore-backup": "node scripts/backupDatabase.js restore",
    "test-backup": "node scripts/backupDatabase.js test",
    "check-dependencies": "node scripts/checkDependencies.js",
    "audit-dependencies": "npm audit",
    "audit-dependencies:fix": "npm audit fix",
    "audit-dependencies:fix-dev": "npm audit fix --dev",
    "rotate-secrets": "node scripts/rotateSecrets.js rotate",
    "secrets-status": "node scripts/rotateSecrets.js status",
    "ci-audit": "node scripts/ciAudit.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.0"
  }
}
